{
	"name": "goodplan",
	"version": "1.0.2",
	"description": "Structured development workflow for Claude Code",
	"author": "Ian White",
	"license": "MIT",
	"homepage": "https://github.com/ian97531/goodplan",
	"repository": {
		"type": "git",
		"url": "https://github.com/ian97531/goodplan.git"
	},
	"type": "module",
	"scripts": {
		"check": "biome check .",
		"test": "vitest",
		"build": "bun build --compile src/index.ts --outfile gp --define __GOODPLAN_VERSION__='\"'$(node -p 'require(\"./package.json\").version')'\"' --define __GP_HMAC_KEY__='\"'${GP_HMAC_KEY:-goodplan-dev-hmac-key}'\"'",
		"build:plugin": "bash scripts/build-plugin.sh",
		"install:skills": "bash scripts/install-skills.sh"
	},
	"dependencies": {
		"@michaelhomer/jqjs": "github:mwh/jqjs",
		"citty": "^0.2.1",
		"picocolors": "^1.1.1",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.2.81",
		"@biomejs/biome": "^1.9.0",
		"bun-types": "^1.3.11",
		"typescript": "^5.8.0",
		"vitest": "^4.0.0"
	}
}
